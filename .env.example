# Copy to .env and fill in. Never commit .env. Only placeholders here.
# The client has no environment variables: it talks to the API on the same origin.

NODE_ENV=development
PORT=4000

# Local: mongodb://127.0.0.1:27017/voyage   Atlas: mongodb+srv://<user>:<password>@<cluster>/voyage
MONGODB_URI=mongodb://127.0.0.1:27017/voyage

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-value-of-at-least-32-characters

# Session lifetime in hours (sliding expiry).
SESSION_TTL_HOURS=168

# Comma-separated exact origins allowed to call the API with credentials.
# Production: exact https origins only, e.g. https://voyage.example.com
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the API (0 when none). Needed for Secure cookies behind TLS termination.
TRUST_PROXY=0

LOG_LEVEL=info

# Production: path to the built client (client/dist) so the API serves the app on one origin.
# CLIENT_DIST_DIR=client/dist

# Rate limits (per client IP, per window).
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_API_MAX=600

# Session clean-up: "native" uses a MongoDB TTL index (recommended); "interval" for servers without TTL support.
SESSION_AUTO_REMOVE=native

# Optional, used only by `npm run seed:demo`. Pick your own password (10+ characters).
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=
